---
import EventTeaser from '../event-teaser/event-teaser.astro';
import ArticleTeaser from '../article-teaser/article-teaser.astro';
import { buildEventTeaserPayload } from '../event-teaser/event-teaser-payload.js';
import { buildArticleTeaserPayload } from '../article-teaser/article-teaser-payload.js';
import { isEvent, isArticle } from '../../util/normalize-post-type.js';
import {
  CONTENT_LISTING_DEFAULTS,
  CONTENT_LISTING_KEY,
} from './content-listing.metadata.js';
import contentListingStylesHref from './content-listing.scss?url';
import eventTeaserStylesHref from '../event-teaser/event-teaser.scss?url';
import articleTeaserStylesHref from '../article-teaser/article-teaser.scss?url';
import 'blaze-slider/dist/blaze.css';

const env = import.meta.env || {};
const mode = process.env.MODE || 'development';
const defaultCmsUrl = (
  mode === 'production' || mode === 'staging' || mode === 'preview'
    ? env.STAGING_CMS
    : env.DEV_CMS
) || '';

const {
  class: className,
  ariaLabel = CONTENT_LISTING_DEFAULTS.ariaLabel,
  busy = false,
  items = [],
  isSlider = CONTENT_LISTING_DEFAULTS.isSlider,
  mountId = CONTENT_LISTING_DEFAULTS.mountId,
  listId = CONTENT_LISTING_DEFAULTS.listId,
  articleHrefBase = CONTENT_LISTING_DEFAULTS.articleHrefBase,
  eventHrefBase = CONTENT_LISTING_DEFAULTS.eventHrefBase,
  cmsUrl = defaultCmsUrl,
} = Astro.props;

const sourceItems = Array.isArray(items) ? items : [];

const eventItems = sourceItems
  .filter((item: any) => isEvent(item))
  .map((item: any, index: number) => buildEventTeaserPayload(
    {
      ...item,
      priority: item?.priority ?? index < 5,
      event_start_date: item?.event_start_date ?? item?.acf?.event_start_date ?? '',
      event_end_date: item?.event_end_date ?? item?.acf?.event_end_date ?? '',
      event_effective_end: item?.event_effective_end ?? item?.acf?.event_effective_end ?? '',
    },
    { hrefBase: eventHrefBase, cmsUrl },
  ));

const articleItems = sourceItems
  .filter((item: any) => isArticle(item))
  .map((item: any) => buildArticleTeaserPayload(item, { hrefBase: articleHrefBase, cmsUrl }));

const itemCount = eventItems.length + articleItems.length;
---

<content-listing
  id={mountId}
  class:list={['content-listing', className, isSlider === true ? 'blaze-slider' : 'card-grid']}
  data-component={CONTENT_LISTING_KEY}
  data-style-deps={
  `${contentListingStylesHref},${eventTeaserStylesHref},${articleTeaserStylesHref}`
  }
>
  {isSlider === true ? (
    <div class="blaze-container">
      <div class="blaze-track-container">
        <section
          id={listId}
          class={`teaser-list blaze-track`}
          role="region"
          aria-label={ariaLabel}
          aria-busy={busy ? 'true' : 'false'}
        >
          {eventItems.map((item: any) => <EventTeaser class="content-listing__item content-listing__item--event" {...item} />)}
          {articleItems.map((item: any) => <ArticleTeaser class="content-listing__item content-listing__item--article" {...item} />)}
        </section>
      </div>
      <a href="javascript:void(0)" role="button" class="blaze-prev"><span>Previous!</span></a>
      <a href="javascript:void(0)" role="button" class="blaze-next"><span>Next!</span></a>
      <nav class="blaze-slide-dots" aria-label="Slide navigation"></nav>
      <div class="blaze-pagination"></div>
    </div>
  ) : (
    <section
      id={listId}
      class="teaser-list"
      role="region"
      aria-label={ariaLabel}
      aria-busy={busy ? 'true' : 'false'}
    >
      {eventItems.map((item: any) => <EventTeaser class="content-listing__item content-listing__item--event" {...item} />)}
      {articleItems.map((item: any) => <ArticleTeaser class="content-listing__item content-listing__item--article" {...item} />)}
    </section>
  )}
</content-listing>

<script>
  import './content-listing.js';
</script>

<style lang="scss">
  @use './content-listing.scss';
</style>
