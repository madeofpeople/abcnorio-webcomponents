---
interface Props {
  data: any;
  hrefBase?: string;
}

const { data, hrefBase = '/articles' } = Astro.props as Props;

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function formatArticleDate(raw: string): { datetime: string; label: string } | null {
  if (!raw) return null;
  const parts = raw.split('-').map(Number);
  if (parts.length < 3 || parts.some(isNaN)) return null;
  const [year, month, day] = parts;
  return {
    datetime: raw,
    label: `${months[month - 1]} ${day}, ${year}`,
  };
}

const dateRaw = data?.acf?.item_date ?? data?.date?.slice(0, 10) ?? '';
const date = formatArticleDate(dateRaw);
const slug = data?.slug || '';
const title = data?.title?.rendered || slug || 'Untitled';
const featuredImage = data?._embedded?.['wp:featuredmedia']?.[0];
const cardSize = featuredImage?.media_details?.sizes?.['abcnorio-card'];
const teaserImage = data?.featured_image?.url ?? cardSize?.source_url ?? featuredImage?.source_url ?? featuredImage?.url ?? '';
const teaserImageAlt = data?.featured_image?.alt ?? featuredImage?.alt_text ?? '';
const href = slug ? `${hrefBase}/${slug}` : hrefBase;
---
<articles-teaser data-component="abcnorio/articles-teaser">
  <article class="teaser article">
    <a href={href}>
      { teaserImage && (
        <img src={teaserImage} alt={teaserImageAlt} loading="lazy" decoding="async" />
      )}
      <div class="content">
        {date && <time datetime={date.datetime}>{date.label}</time>}
        <h3 set:html={title}></h3>
      </div>
    </a>
  </article>
</articles-teaser>

<script>
  import './articles-teaser.js';
</script>

<style lang="scss">
  @use './articles-teaser.scss';
</style>
