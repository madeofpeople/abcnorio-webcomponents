---
const {
  class: className,
  title,
  description,
  start,
  end,
  location,
  timeZone,
  url,
  buttonLabel = 'Add to cal',
  googleLabel = 'Google',
  appleLabel = 'Apple',
  outlookLabel = 'Outlook',
} = Astro.props;
---

<add-to-calendar-button
  class:list={['add-to-calendar', className]}
  data-title={title}
  data-description={description}
  data-start={start}
  data-end={end}
  data-location={location}
  data-time-zone={timeZone}
  data-url={url}
>
  <button class="atc-actuator alt" type="button" aria-expanded="false">
    <slot name="icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="M21 10H3M16 2V6M8 2V6M7.8 22H16.2C17.8802 22 18.7202 22 19.362 21.673C19.9265 21.3854 20.3854 20.9265 20.673 20.362C21 19.7202 21 18.8802 21 17.2V8.8C21 7.11984 21 6.27976 20.673 5.63803C20.3854 5.07354 19.9265 4.6146 19.362 4.32698C18.7202 4 17.8802 4 16.2 4H7.8C6.11984 4 5.27976 4 4.63803 4.32698C4.07354 4.6146 3.6146 5.07354 3.32698 5.63803C3 6.27976 3 7.11984 3 8.8V17.2C3 18.8802 3 19.7202 3.32698 20.362C3.6146 20.9265 4.07354 21.3854 4.63803 21.673C5.27976 22 6.11984 22 7.8 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </slot>
    <span>{buttonLabel}</span>
  </button>

  <div class="atc-drawer" hidden>
    <button class="act-google" type="button">{googleLabel}</button>
    <button class="act-apple" type="button">{appleLabel}</button>
    <button class="act-outlook" type="button">{outlookLabel}</button>
    <slot />
  </div>
</add-to-calendar-button>

<script>
  import './add-to-calendar.js';
</script>

<style lang="scss">
  @use './add-to-calendar.scss';
</style>