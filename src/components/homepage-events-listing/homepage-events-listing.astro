---
interface Props {
  items?: any[];
  teaserComponent?: any;
  requiredProps?: string[];
  limit?: number;
}

const {
  items = [],
  teaserComponent,
  requiredProps = [],
  limit = 7,
} = Astro.props as Props;

const hasValue = (value: any) => value !== null && value !== undefined && String(value).trim() !== '';

const readRequiredProp = (item: any, prop: string) => {
  if (prop === 'title') {
    return item?.title?.rendered;
  }

  if (prop === 'excerpt') {
    return item?.excerpt?.rendered;
  }

  return item?.acf?.[prop];
};

let listing = Array.isArray(items)
  ? items.filter((item: any) => (
      !requiredProps.length || requiredProps.every((prop) => hasValue(readRequiredProp(item, prop)))
    ))
  : [];

listing = listing.slice(0, limit);

const Tag = teaserComponent;
---

<homepage-events-listing data-component="abcnorio/homepage-events-listing">
  <section class="event_listing listing">
    {Tag && listing.map((result: any) => (
      <Tag data={result} />
    ))}
  </section>
</homepage-events-listing>

<script>
  import './homepage-events-listing.js';
</script>

<style lang="scss">
  @use './homepage-events-listing.scss';
</style>
