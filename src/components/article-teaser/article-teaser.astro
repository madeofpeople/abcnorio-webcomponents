---
const {
  class: className,
  href = '#',
  title = 'Untitled article',
  dateLabel = '',
  dateTime = '',
  featured_image = null,
} = Astro.props;

const imageProps = featured_image && typeof featured_image === 'object' ? featured_image : null;
const excerpt = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.';
---

<article-teaser
  class:list={[
    'article-teaser',
    'articles',
    className,
  ]}
  data-component="abcnorio/article-teaser"
>
  <a href={href}>
    {
      imageProps?.url && (
        <img
          class="article-teaser__image"
          src={imageProps.url}
          alt={imageProps.alt || ''}
          width={Number(imageProps.width || 900)}
          height={Number(imageProps.height || 600)}
          decoding="async"
          loading="lazy"
        />
      )
    }

    {
      dateLabel && (
        <time class="article-teaser__date" datetime={dateTime}>
          {dateLabel}
        </time>
      )
    }

    <div class="article-teaser__content">
      <h3 class="article-teaser__title" set:html={title} />
      <div class="article-teaser__excerpt" set:html={excerpt} />
    </div>
  </a>
</article-teaser>

<script>
  import "./article-teaser.js";
</script>

<style lang="scss">
  @use "./article-teaser.scss";
</style>
