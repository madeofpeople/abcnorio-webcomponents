---
interface Props {
    currentPage: number;
    totalPages: number;
    hxGet: string;
    hrefBase?: string;
    hxTarget: string;
    hxInclude?: string;
    id?: string;
    oob?: boolean;
}

const { currentPage, totalPages, hxGet, hrefBase, hxTarget, hxInclude, id = 'pagination', oob = false } = Astro.props;
const sep = hxGet.includes('?') ? '&' : '?';
const linkBase = hrefBase ?? hxGet;
const linkSep = linkBase.includes('?') ? '&' : '?';
const linkForPage = (page: number) => `${linkBase}${linkSep}page=${page}`;
---
<nav
    id={id}
    class="pagination"
    aria-label="Pagination"
    hx-swap-oob={oob ? 'outerHTML' : undefined}
>
    {totalPages > 1 && (
        <ul>
            {currentPage > 1 && (
                <li>
                    <a href={linkForPage(currentPage - 1)}
                       hx-get={`${hxGet}${sep}page=${currentPage - 1}`}
                       hx-target={hxTarget}
                              hx-swap="outerHTML swap:0.2s settle:0.2s"
                       hx-include={hxInclude}>
                        &laquo; Prev
                    </a>
                </li>
            )}
            {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
                <li>
                    <a href={linkForPage(p)}
                       hx-get={`${hxGet}${sep}page=${p}`}
                       hx-target={hxTarget}
                              hx-swap="outerHTML swap:0.2s settle:0.2s"
                       hx-include={hxInclude}
                       aria-current={p === currentPage ? 'page' : undefined}
                       class={p === currentPage ? 'is-current' : ''}>
                        {p}
                    </a>
                </li>
            ))}
            {currentPage < totalPages && (
                <li>
                    <a href={linkForPage(currentPage + 1)}
                       hx-get={`${hxGet}${sep}page=${currentPage + 1}`}
                       hx-target={hxTarget}
                              hx-swap="outerHTML swap:0.2s settle:0.2s"
                       hx-include={hxInclude}>
                        Next &raquo;
                    </a>
                </li>
            )}
        </ul>
    )}
</nav>
<style lang="scss">
  @use './pagination.scss';
</style>