---
const { class: className, title = 'John Doe' } = Astro.props;
---

<user-card class:list={['user-card', className]}>
	<div class="card-wrapper">
		<h3>{title}</h3>
		<slot />
	</div>
</user-card>

<script>
	import './user-card.js';
</script>

<style lang="scss">
	@use './user-card.scss';
</style>
