---
import stylesHref from './collective-teaser.scss?url';

const {
  class: className,
  href = '#',
  title = 'Untitled collective',
  excerpt,
  featured_image = null,
  includeStyles = true,
} = Astro.props;

const imageProps = featured_image && typeof featured_image === 'object' ? featured_image : null;
---

{includeStyles && <link rel="stylesheet" href={stylesHref} />}
<collective-teaser class:list={['collective-teaser', className]} data-component="abcnorio/collective-teaser">
  <a href={href}>
    {imageProps?.url && (
      <img
        class="collective-teaser__image"
        src={imageProps.url}
        alt={imageProps.alt || ''}
        width={Number(imageProps.width || 290)}
        height={Number(imageProps.height || 9999)}
        decoding="async"
        loading="lazy"
      />
    )}

    <div class="collective-teaser__content">
      <h3 class="collective-teaser__title" set:html={`${title} ` } />
      <div class="collective-teaser__excerpt" set:html={excerpt} />
    </div>
  </a>
</collective-teaser>

<script>
  import './collective-teaser.js';
</script>
