---
import EventTeaser from "../event-teaser/event-teaser.astro";
import Pagination from "../pagination/pagination.astro";
import { buildEventTeaserPayload } from "../event-teaser/event-teaser-payload.js";
import { resolveFeaturedImage } from "../../util/resolve-featured-image.js";
import {
  EVENT_LISTING_DEFAULTS,
  EVENT_LISTING_KEY,
} from "./event-listing.metadata.js";
import eventTeaserStylesHref from "../event-teaser/event-teaser.scss?url";
import eventListingStylesHref from "../event-listing/event-listing.scss?url";
import 'blaze-slider/dist/blaze.css';

const env = import.meta.env || {};
const mode = process.env.MODE || 'development';
const defaultCmsUrl = (
  mode === 'production' || mode === 'staging' || mode === 'preview'
    ? env.STAGING_CMS
    : env.DEV_CMS
) || '';

interface EventTeaserItem {
  href?: string;
  slug?: string;
  title?: string;
  excerpt?: string;
  priority?: boolean;
  isPastEvent?: boolean;
  startLabelDate?: string;
  startLabelTime?: string;
  startDateTime?: string;
  page?: number;
  totalResults?: number;
  totalPages?: number;
  isSlider?: boolean;
  showAllLink?: boolean;

  featured_image?: {
    url?: string;
    alt?: string;
    width?: number;
    height?: number;
  } | null;
}

type SliderPreset = 'default' | 'compact';

const {
  class: className,
  ariaLabel = EVENT_LISTING_DEFAULTS.ariaLabel,
  busy = false,
  items = [],
  totalPages,
  isSlider = false,
  sliderPreset = 'default',
  showPagination = false,
  showAllLink = true,
  page,
  hrefBase = EVENT_LISTING_DEFAULTS.hrefBase,
  cmsUrl = defaultCmsUrl,
  mountId = EVENT_LISTING_DEFAULTS.mountId,
  teaserListId = EVENT_LISTING_DEFAULTS.teaserListId,
  paginationId = EVENT_LISTING_DEFAULTS.paginationId,
  filtersFormSelector = EVENT_LISTING_DEFAULTS.filtersFormSelector,
} = Astro.props;

const sourceItems = (Array.isArray(items) ? items : []) as any[];

const looksLikeTeaserPayload = (item: any) =>
  typeof item?.href === "string" || typeof item?.startLabelDate === "string";

const normalizedItems = sourceItems.map((item: any, index: number) => {
  if (looksLikeTeaserPayload(item)) {
    const normalizedFeaturedImage = resolveFeaturedImage(
      { featured_image: item?.featured_image ?? null },
      {
        size: 'abcnorio-card',
        defaultWidth: 290,
        defaultHeight: 9999,
        cmsUrl,
      },
    );

    return {
      ...(item as EventTeaserItem),
      featured_image: normalizedFeaturedImage || item?.featured_image || null,
    } as EventTeaserItem;
  }

  return buildEventTeaserPayload(
    {
      ...item,
      priority: item?.priority ?? index < 5,
      event_start_date:
        item?.event_start_date ?? item?.meta?.event_start_date ?? "",
      event_end_date: item?.event_end_date ?? item?.meta?.event_end_date ?? "",
      event_effective_end:
        item?.event_effective_end ?? item?.meta?.event_effective_end ?? "",
    },
    { hrefBase, cmsUrl },
  );
});

const itemCount = normalizedItems.length;
---

<event-listing
  id={mountId}
  class:list={['event-listing', className, isSlider === true ? 'blaze-slider' : 'card-grid']}
  data-component={EVENT_LISTING_KEY}
  data-slider-preset={sliderPreset}
  data-style-deps={
    `${eventListingStylesHref},${eventTeaserStylesHref}`
  }
>
  {isSlider === true ? (
    <div class="blaze-container">
      <div class="blaze-track-container">

        <section
          id={teaserListId}
          class={`teaser-list blaze-track`}
          role="region"
          aria-label={ariaLabel}
          aria-busy={busy ? "true" : "false"}
        >
          {itemCount > 0 && normalizedItems.map((item) => <EventTeaser {...item} />)}
        </section>

      </div>

      <a href="javascript:void(0)" role="button" class="blaze-prev"><span>Previous!</span></a>
      <a href="javascript:void(0)" role="button" class="blaze-next"><span>Next!</span></a>
      <nav class="blaze-slide-dots" aria-label="Slide navigation"></nav>
      <div class="blaze-pagination"></div>
    </div>
  ):(
      <section
    id={teaserListId}
    class={`teaser-list`}
    role="region"
    aria-label={ariaLabel}
    aria-busy={busy ? "true" : "false"}
  >
    {itemCount > 0 && normalizedItems.map((item) => <EventTeaser {...item} />)}
    </section>

  )}

  {showPagination === true && (
    <Pagination
      id={paginationId}
      currentPage={page}
      totalPages={totalPages}
      hxGet="/events/listing"
      hrefBase={hrefBase}
      hxTarget={`#${mountId}`}
      hxInclude={filtersFormSelector}
    />
  )}

  {showAllLink === true && (
    <a href="/events" class="show-all button">View all</a>
  )}
</event-listing>

<script>
  import "./event-listing.js";
</script>

<style lang="scss">
  @use "./event-listing.scss";
</style>
