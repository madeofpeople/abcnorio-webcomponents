---
import imageSizes from './image-sizes.json';

const {
  component: _component,
  attributes = {},
  innerBlocks = [],
  variant,
  ...routerProps
} = Astro.props;

const rawVariant = String(
  variant || attributes?.variant || attributes?.className || 'default',
).toLowerCase();
let resolvedVariant = 'default';
if (rawVariant.includes('slider') || rawVariant === 'carousel') {
  resolvedVariant = 'slider';
}
if (rawVariant === 'paged-grid') {
  resolvedVariant = 'paged-grid';
}
if (rawVariant === 'masonry') {
  resolvedVariant = 'masonry';
}
const isPagedGrid = resolvedVariant === 'paged-grid';
const isMasonry = resolvedVariant === 'masonry';
const usesBlaze = !isPagedGrid && !isMasonry;
const requestedNavigation = String(attributes?.navigationMode || attributes?.navigation_mode || 'item').toLowerCase();
let navigationMode = requestedNavigation === 'page' ? 'page' : 'item';
if (isPagedGrid) {
  navigationMode = 'page';
}
const parsedItemsPerPage = Number.parseInt(String(attributes?.itemsPerPage ?? 8), 10) || 8;
const itemsPerPage = Math.min(24, Math.max(8, parsedItemsPerPage));
const extraClasses = String(attributes?.className || '')
  .split(/\s+/)
  .map((entry) => entry.trim())
  .filter(Boolean);

// paged-grid must not carry blaze classes, even if the editor className includes them
const classes = usesBlaze ? extraClasses : extraClasses.filter((name) => !name.startsWith('blaze'));

const galleryClass = [
  'gallery',
  usesBlaze && 'blaze-slider',
  `gallery--${resolvedVariant}`,
  `gallery--nav-${navigationMode}`,
  ...classes,
].filter(Boolean).join(' ');

const RecursiveBlock = routerProps.Block || null;
const recursiveProps = {
  ...routerProps,
  Block: RecursiveBlock,
};

const blocks = Array.isArray(innerBlocks) ? innerBlocks : [];
---
<gallery-listing class={galleryClass} data-variant={resolvedVariant} data-navigation-mode={navigationMode} data-items-per-page={itemsPerPage}>
  <div class:list={{ 'blaze-container': usesBlaze }}>
    <div class:list={{ 'blaze-track-container': usesBlaze }}>
      <div class:list={['images', usesBlaze && 'blaze-track']}>
        {RecursiveBlock && blocks.length > 0 && blocks.map((block: any) => {
          const imageSize = imageSizes[resolvedVariant as keyof typeof imageSizes] || imageSizes.default;
          const imageVariant = block.attributes.sizes_data?.[imageSize]
            || block.attributes.media_details?.sizes?.[imageSize];
          const lightboxImage = block.attributes.sizes_data?.large
            || block.attributes.media_details?.sizes?.large;
          const imageAttributes = {
            ...block.attributes,
            sizeSlug: imageSize,
            url: imageVariant?.source_url || block.attributes.url,
            lightboxSrc: lightboxImage?.source_url,
            lightboxWidth: lightboxImage?.width,
            lightboxHeight: lightboxImage?.height,
            srcset: undefined,
            sizes: undefined,
            loading: 'lazy',
          };
          return (
            <div class="gallery-item">
              <RecursiveBlock
                {...recursiveProps}
                component={block.name}
                attributes={imageAttributes}
                innerBlocks={block.innerBlocks || null}
              />
            </div>
          );
        })}
      </div>
    </div>

    {usesBlaze && <a href="javascript:void(0)" role="button" class="blaze-prev"><span>Previous!</span></a>}
    {usesBlaze && <a href="javascript:void(0)" role="button" class="blaze-next"><span>Next!</span></a>}
    {usesBlaze && <div class="blaze-pagination"></div>}
  </div>

  {usesBlaze && <nav class="blaze-slide-dots" aria-label="Slide navigation"></nav>}
  {isPagedGrid && <nav class="gallery-pagination" aria-label="Gallery pagination" hidden></nav>}
</gallery-listing>

<script>
  import './gallery.ts';
</script>

<style lang="scss">
  @use './gallery.scss';
</style>
