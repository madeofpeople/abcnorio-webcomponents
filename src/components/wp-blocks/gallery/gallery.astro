---
import imageSizes from './image-sizes.json';
import stylesHref from './gallery.scss?url';
import GalleryItem from './GalleryItem.astro';

const {
  component: _component,
  attributes = {},
  innerBlocks = [],
  variant,
  additionalClasses = '',
  editorShell = false,
  ...routerProps
} = Astro.props;

const rawVariant = String(
  variant || attributes?.variant || attributes?.className || 'default',
).toLowerCase();
let resolvedVariant = 'default';
if (rawVariant.includes('slider') || rawVariant === 'carousel') {
  resolvedVariant = 'slider';
}
if (rawVariant === 'paged-grid') {
  resolvedVariant = 'paged-grid';
}
if (rawVariant === 'masonry') {
  resolvedVariant = 'masonry';
}
if (rawVariant === 'captioned') {
  resolvedVariant = 'captioned';
}
const isCaptioned = resolvedVariant === 'captioned';
const isPagedGrid = resolvedVariant === 'paged-grid';
const isMasonry = resolvedVariant === 'masonry';
const usesBlaze = !isPagedGrid && !isMasonry;
const navigationMode = 'page';
const parsedItemsPerPage = Number.parseInt(String(attributes?.itemsPerPage ?? 8), 10) || 8;
const itemsPerPage = Math.min(24, Math.max(8, parsedItemsPerPage));
const extraClasses = String(attributes?.className || '')
  .split(/\s+/)
  .map((entry) => entry.trim())
  .filter(Boolean);

// paged-grid must not carry blaze classes, even if the editor className includes them
const classes = usesBlaze ? extraClasses : extraClasses.filter((name) => !name.startsWith('blaze'));

const galleryClass = [
  'gallery',
  usesBlaze && 'blaze-slider',
  `gallery--${resolvedVariant}`,
  `gallery--nav-${navigationMode}`,
  additionalClasses,
  ...classes,
].filter(Boolean).join(' ');

const RecursiveBlock = routerProps.Block || null;
const recursiveProps = {
  ...routerProps,
  Block: RecursiveBlock,
};

const blocks = Array.isArray(innerBlocks) ? innerBlocks : [];
---
<link rel="stylesheet" href={stylesHref} />
<gallery-listing
  class:list={[editorShell ? 'gallery' : galleryClass]}
  data-variant={resolvedVariant}
  data-navigation-mode={navigationMode}
  data-items-per-page={itemsPerPage}
  data-editor-root={editorShell ? '' : undefined}
>
  <div class:list={{ 'blaze-container': usesBlaze }} data-editor-bind={editorShell ? 'container' : undefined}>
    <div class:list={{ 'blaze-track-container': usesBlaze }} data-editor-bind={editorShell ? 'viewport' : undefined}>
      <div class:list={['images', usesBlaze && 'blaze-track']} data-editor-bind={editorShell ? 'track' : undefined}>
        <slot>
        {RecursiveBlock && blocks.length > 0 && blocks.map((block: any) => {
          const imageSize = imageSizes[resolvedVariant as keyof typeof imageSizes] || imageSizes.default;
          const imageVariant = block.attributes.sizes_data?.[imageSize]
            || block.attributes.media_details?.sizes?.[imageSize];
          const lightboxImage = block.attributes.sizes_data?.large
            || block.attributes.media_details?.sizes?.large;
          const imageAttributes = {
            ...block.attributes,
            sizeSlug: imageSize,
            url: imageVariant?.source_url || block.attributes.url,
            lightboxSrc: lightboxImage?.source_url,
            lightboxWidth: lightboxImage?.width,
            lightboxHeight: lightboxImage?.height,
            srcset: undefined,
            sizes: undefined,
            loading: 'lazy',
          };
          return (
            <GalleryItem>
              {isCaptioned ? (
                <figure class="gallery__image">
                  <RecursiveBlock
                    {...recursiveProps}
                    component={block.name}
                    attributes={{ ...imageAttributes, caption: '' }}
                    innerBlocks={block.innerBlocks || null}
                    additionalClasses="gallery__image"
                  />
                  {block.attributes.caption && <figcaption set:html={block.attributes.caption} />}
                </figure>
              ) : <RecursiveBlock
                {...recursiveProps}
                component={block.name}
                attributes={imageAttributes}
                innerBlocks={block.innerBlocks || null}
                additionalClasses="gallery__image"
              />}
            </GalleryItem>
          );
        })}
        </slot>
      </div>
    </div>

    {(usesBlaze || editorShell) && <button type="button" class="blaze-prev" data-editor-bind={editorShell ? 'previous' : undefined}><span>Previous!</span></button>}
    {(usesBlaze || editorShell) && <button type="button" class="blaze-next" data-editor-bind={editorShell ? 'next' : undefined}><span>Next!</span></button>}
    {(usesBlaze || editorShell) && <div class="blaze-pagination" data-editor-bind={editorShell ? 'pagination' : undefined}></div>}
  </div>

  {(usesBlaze || editorShell) && <nav class="blaze-slide-dots" aria-label="Slide navigation" data-editor-bind={editorShell ? 'dots' : undefined}>
    <template data-gallery-template="dot" data-editor-repeat={editorShell ? 'dots' : undefined}>
      <button type="button" class="blaze-slide-dot" data-editor-bind={editorShell ? 'button' : undefined}></button>
    </template>
  </nav>}
  {(isPagedGrid || editorShell) && <nav class="gallery-pagination" aria-label="Gallery pagination" hidden={!editorShell} data-editor-bind={editorShell ? 'pages' : undefined}>
    <ul>
      <li><button type="button" aria-label="Previous page" data-editor-bind={editorShell ? 'previous-page' : undefined}>&laquo; Prev</button></li>
      <template data-gallery-template="page" data-editor-repeat={editorShell ? 'pages' : undefined}>
        <li><button type="button" data-editor-bind={editorShell ? 'button' : undefined}></button></li>
      </template>
      <li><button type="button" aria-label="Next page" data-editor-bind={editorShell ? 'next-page' : undefined}>Next &raquo;</button></li>
    </ul>
  </nav>}
  <template data-gallery-template="item"><GalleryItem /></template>
</gallery-listing>

<script>
  import './gallery.js';
</script>
