---
const {
  component: _component,
  attributes = {},
  innerBlocks = [],
  variant,
  ...routerProps
} = Astro.props;

const rawVariant = String(
  variant || attributes?.variant || attributes?.className || 'default',
).toLowerCase();
const resolvedVariant =
  rawVariant.includes('slider') || rawVariant === 'carousel'
    ? 'slider'
    : rawVariant === 'paged-grid'
      ? 'paged-grid'
      : 'default';
const isSliderVariant = resolvedVariant === 'slider';
const isPagedGrid = resolvedVariant === 'paged-grid';
const navigationMode = isPagedGrid || String(attributes?.navigationMode || attributes?.navigation_mode || 'item').toLowerCase() === 'page'
  ? 'page'
  : 'item';
const extraClasses = String(attributes?.className || '')
  .split(/\s+/)
  .map((entry) => entry.trim())
  .filter(Boolean);

const galleryClass = [
  'gallery',
  isPagedGrid ? undefined : 'blaze-slider',
  isSliderVariant ? 'gallery--slider' : isPagedGrid ? undefined : 'gallery--default',
  `gallery--nav-${navigationMode}`,
  resolvedVariant !== 'default' ? `gallery--${resolvedVariant}` : undefined,
  ...extraClasses,
].filter(Boolean).join(' ');

const RecursiveBlock = routerProps.Block || null;
const recursiveProps = {
  ...routerProps,
  Block: RecursiveBlock,
};

const blocks = Array.isArray(innerBlocks) ? innerBlocks : [];
---
<gallery-listing class={galleryClass} data-variant={resolvedVariant} data-navigation-mode={navigationMode}>
  <div class="blaze-container">
    <div class="blaze-track-container">
      <div class="images blaze-track">
        {RecursiveBlock && blocks.length > 0 && blocks.map((block: any) => {
          block.attributes.loading = 'lazy';
          return (
            <div class="gallery-item">
              <RecursiveBlock
                {...recursiveProps}
                component={block.name}
                attributes={block.attributes}
                innerBlocks={block.innerBlocks || null}
              />
            </div>
          );
        })}
      </div>
    </div>

    {!isPagedGrid && <a href="javascript:void(0)" role="button" class="blaze-prev"><span>Previous!</span></a>}
    {!isPagedGrid && <a href="javascript:void(0)" role="button" class="blaze-next"><span>Next!</span></a>}
    {!isPagedGrid && <div class="blaze-pagination"></div>}
  </div>

  {isPagedGrid
    ? <nav class="gallery-pagination" aria-label="Gallery pagination" hidden></nav>
    : <nav class="blaze-slide-dots" aria-label="Slide navigation"></nav>}
</gallery-listing>

<script>
  import './gallery.ts';
</script>

<style lang="scss">
  @use './gallery.scss';
</style>
