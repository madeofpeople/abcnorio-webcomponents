---
const {
  innerBlocks = [],
  Block,
  restPath,
  cmsUrl,
  registry,
  embedRegistry,
  showDebug,
} = Astro.props;
const RecursiveBlock = Block || null;
---
<blockquote class="quote">
  {RecursiveBlock && innerBlocks.length > 0 && innerBlocks.map((innerBlock: any) => (
    <RecursiveBlock
      component={innerBlock.name}
      attributes={innerBlock.attributes}
      innerBlocks={innerBlock.innerBlocks || null}
      restPath={restPath}
      cmsUrl={cmsUrl}
      registry={registry}
      embedRegistry={embedRegistry}
      showDebug={showDebug}
    />
  ))}
</blockquote>
