---
const {
  component: _component,
  attributes,
  innerBlocks = [],
  additionalClasses = '',
  ...routerProps
} = Astro.props;
const RecursiveBlock = routerProps.Block || null;
const recursiveProps = {
  ...routerProps,
  Block: RecursiveBlock,
};
---
<blockquote class:list={["quote", additionalClasses, attributes?.className]}>
  {RecursiveBlock && innerBlocks.length > 0 && innerBlocks.map((innerBlock: any) => (
    <RecursiveBlock
      {...recursiveProps}
      component={innerBlock.name}
      attributes={innerBlock.attributes}
      innerBlocks={innerBlock.innerBlocks || null}
    />
  ))}
</blockquote>

<style is:global lang="scss">
  @import './quote.scss';
</style>
