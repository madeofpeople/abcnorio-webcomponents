---
const { attributes } = Astro.props;
const iframeAttributes = {
  src: attributes.url,
  responsive: 'true',
  allowfullscreen: true,
  allow: 'autoplay; fullscreen; web-share; xr-spatial-tracking;',
};
---
<iframe
  {...iframeAttributes}
></iframe>
<style>
  iframe {
    border: none;
    width: 100%;
    aspect-ratio: 16/9;
  }
</style>
