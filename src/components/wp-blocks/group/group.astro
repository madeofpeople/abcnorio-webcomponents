---
import stylesHref from './group.scss?url';
const {
  component: _component,
  attributes,
  innerBlocks = [],
  ...routerProps
} = Astro.props;
const Tag = attributes?.tagName || 'div';
const layout = attributes?.layout;
const childLayout = attributes?.style?.layout;
const sizing = childLayout?.selfStretch;
const hasSizing = ['fit', 'fill', 'fixed', 'fixedNoShrink'].includes(sizing);
const childStyle = hasSizing ? {
  flexGrow: sizing === 'fill' ? 1 : 0,
  flexShrink: sizing === 'fixedNoShrink' ? 0 : 1,
  flexBasis: ['fixed', 'fixedNoShrink'].includes(sizing) ? childLayout.flexSize : 'auto',
  boxSizing: 'border-box',
} : undefined;
const layoutClasses = [
  layout?.type && `is-layout-${layout.type}`,
  layout?.orientation && `is-${layout.orientation}`,
  layout?.justifyContent && `is-content-justification-${layout.justifyContent}`,
  layout?.flexWrap === 'nowrap' && 'is-nowrap',
];
const RecursiveBlock = routerProps.Block || null;
const recursiveProps = {
  ...routerProps,
  Block: RecursiveBlock,
};
---
<link rel="stylesheet" href={stylesHref} />
<Tag class:list={['wp-block-group', attributes?.className, layoutClasses]} style={childStyle}>
  {RecursiveBlock  && innerBlocks?.map((block: any) => (
    <RecursiveBlock
      {...recursiveProps}
      component={block.name}
      attributes={block.attributes}
      innerBlocks={block.innerBlocks || null}
    />
  ))}
</Tag>
