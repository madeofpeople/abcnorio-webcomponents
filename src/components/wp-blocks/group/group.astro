---
import '../_wp-blocks.scss';

const { attributes, innerBlocks = [], Block } = Astro.props;
const Tag = attributes?.tagName || 'div';
---

<Tag class:list={['wp-block-group', attributes?.className]}>
  {innerBlocks.map((block: any) => (
    <Block component={block.name} attributes={block.attributes} innerBlocks={block.innerBlocks} />
  ))}
</Tag>
