---
import '../_wp-blocks.scss';

const {
  attributes,
  innerBlocks = [],
  Block,
  restPath,
  cmsUrl,
  registry,
  embedRegistry,
  showDebug,
} = Astro.props;
const Tag = attributes?.tagName || 'div';
const RecursiveBlock = Block || null;
---

<Tag class:list={['wp-block-group', attributes?.className]}>
  {RecursiveBlock && innerBlocks.map((block: any) => (
    <RecursiveBlock
      component={block.name}
      attributes={block.attributes}
      innerBlocks={block.innerBlocks || null}
      restPath={restPath}
      cmsUrl={cmsUrl}
      registry={registry}
      embedRegistry={embedRegistry}
      showDebug={showDebug}
    />
  ))}
</Tag>
