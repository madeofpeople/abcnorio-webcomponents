---
/* this file adapts data from expecting API response to a WP block shape */
import ContentListing from '../../content-listing/content-listing.astro';
import { normalizePostType } from '../../../util/normalize-post-type.js';
import { contentListingUrl } from './content-list-request.js';

const {
  attributes = {},
  restPath = '',
  cmsUrl = '',
  articleHrefBase = '/articles',
  eventHrefBase = '/events',
  isSlider,
} = Astro.props;

const blockData = attributes?.data ?? attributes ?? {};
const resolvedIsSlider =
  typeof isSlider === 'boolean'
    ? isSlider
    : String(blockData?.variant || 'grid').toLowerCase() === 'slider';
const title = String(blockData?.title || '').trim();
const hasCta = Boolean(blockData?.hasCta ?? blockData?.has_cta ?? false);
const ctaLabel = String(blockData?.ctaLabel ?? blockData?.cta_label ?? '').trim();
const ctaUrl = String(blockData?.ctaUrl ?? blockData?.cta_url ?? '').trim();

const endpoint = contentListingUrl(restPath, blockData);
const response = await fetch(endpoint, { signal: AbortSignal.timeout(12000) });
if (!response.ok) {
  throw new Error(`Content listing request failed: HTTP ${response.status}.`);
}
const rawItems = await response.json();
if (!Array.isArray(rawItems)) {
  throw new Error('Content listing response must be an array.');
}
const items = rawItems.map((item) => normalizePostType(item));
---
<ContentListing
  class={blockData?.className}
  title={title}
  showCount={Boolean(blockData?.showCount)}
  items={items}
  isSlider={resolvedIsSlider}
  variant={blockData?.variant}
  gridColumns={blockData?.gridColumns}
  slidesPerPage={blockData?.slidesPerPage}
  slidesPerPageXs={blockData?.slidesPerPageXs}
  slidesPerPageSm={blockData?.slidesPerPageSm}
  slidesPerPageMd={blockData?.slidesPerPageMd}
  slidesPerPageLg={blockData?.slidesPerPageLg}
  hasCta={hasCta}
  ctaLabel={ctaLabel}
  ctaUrl={ctaUrl}
  articleHrefBase={articleHrefBase}
  eventHrefBase={eventHrefBase}
  cmsUrl={cmsUrl}
/>
