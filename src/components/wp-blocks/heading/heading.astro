---
const { attributes } = Astro.props;
const level = attributes?.level ?? 2;
const content = attributes?.content ?? '';
const id = attributes?.anchor;
---
{level === 1 && <h1 id={id} set:html={content} />}
{level === 2 && <h2 id={id} set:html={content} />}
{level === 3 && <h3 id={id} set:html={content} />}
{level === 4 && <h4 id={id} set:html={content} />}
{level === 5 && <h5 id={id} set:html={content} />}
{level === 6 && <h6 id={id} set:html={content} />}
