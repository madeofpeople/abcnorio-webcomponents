---
import { Debug } from 'astro:components';
import { BLOCK_REGISTRY, EMBED_PROVIDER_REGISTRY } from '../block-registry.js';

const {
  component,
  attributes,
  innerBlocks,
  registry = {},
  embedRegistry = {},
  showDebug = true,
  ...routerProps
} = Astro.props;

const RecursiveBlock = routerProps.Block || Astro.self;

const baseRegistry = BLOCK_REGISTRY;

const baseEmbedRegistry = EMBED_PROVIDER_REGISTRY;

const mergedRegistry = {
  ...baseRegistry,
  ...registry,
};

const mergedEmbedRegistry = {
  ...baseEmbedRegistry,
  ...embedRegistry,
};

const providerName = String(attributes?.providerNameSlug || '').toLowerCase();

let Component = mergedRegistry[component];

if (component === 'core/embed' && providerName) {
  Component = mergedEmbedRegistry[providerName] || Component;
}

const shouldRenderDebug = !Component && showDebug;

const passThroughProps = {
  ...routerProps,
  Block: RecursiveBlock,
  registry,
  embedRegistry,
  showDebug,
};
---

{Component && (
  <Component
    attributes={attributes}
    component={component}
    innerBlocks={innerBlocks || null}
    {...passThroughProps}
  />
)}

{shouldRenderDebug && (
  <div class="debug-block">
    <p><strong>Unknown block type:</strong> {component}</p>
    <Debug component={component} />
    <Debug attributes={attributes} />
  </div>
)}
