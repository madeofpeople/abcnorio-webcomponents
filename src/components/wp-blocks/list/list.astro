---
const {
  component: _component,
  attributes,
  innerBlocks = [],
  additionalClasses = '',
  ...routerProps
} = Astro.props;
const RecursiveBlock = routerProps.Block || null;
const Tag = attributes?.ordered ? 'ol' : 'ul';
const recursiveProps = {
  ...routerProps,
  Block: RecursiveBlock,
};
---
<Tag
  class:list={["list", additionalClasses, attributes?.className]}
  start={attributes?.ordered ? attributes?.start : undefined}
  reversed={attributes?.ordered ? attributes?.reversed : undefined}
  style={attributes?.ordered && attributes?.type && attributes.type !== 'decimal' ? { 'list-style-type': attributes.type } : undefined}
>
  {RecursiveBlock && innerBlocks.length > 0 && innerBlocks.map((block: any) => (
    <RecursiveBlock
      {...recursiveProps}
      component={block.name}
      attributes={block.attributes}
      innerBlocks={block.innerBlocks || null}
    />
  ))}
</Tag>

<style is:global lang="scss">
  @use './list.scss';
</style>
