---
import './hero.scss';

const {
  component: _component,
  srcset,
  attributes,
  innerBlocks = [],
  ...routerProps
} = Astro.props;

const RecursiveBlock = routerProps.Block || null;
const recursiveProps = {
  ...routerProps,
  Block: RecursiveBlock,
};

const sizesData = attributes?.sizes_data || {};
const rawVariant = String(attributes?.variant ?? 'default').toLowerCase();
const variant = rawVariant === 'short' || rawVariant === 'thin' ? rawVariant : 'default';

type ImageVariant = {
  source_url?: string;
  url?: string;
  src?: string;
  width: number;
  height?: number;
};

const isImageVariant = (candidate: unknown): candidate is ImageVariant => {
  if (typeof candidate !== 'object' || candidate === null || !('width' in candidate)) {
    return false;
  }

  const hasSource = (
    'source_url' in candidate && typeof candidate.source_url === 'string'
  ) || (
    'url' in candidate && typeof candidate.url === 'string'
  ) || (
    'src' in candidate && typeof candidate.src === 'string'
  );

  return hasSource && typeof candidate.width === 'number';
};

const getSizeUrl = (...keys: string[]) => {
  for (const key of keys) {
    const candidate = sizesData?.[key];

    if (!candidate) {
      continue;
    }

    if (typeof candidate === 'string') {
      return candidate;
    }

    if (typeof candidate === 'object') {
      if (candidate.source_url) {
        return candidate.source_url;
      }
      if (candidate.url) {
        return candidate.url;
      }
      if (candidate.src) {
        return candidate.src;
      }
    }
  }
  return '';
};

const imageVariant = ['large', 'medium', 'small', 'thumbnail', 'full']
  .map((key) => sizesData[key])
  .find(isImageVariant);
const imageSrc = getSizeUrl('large', 'medium', 'small', 'thumbnail', 'full') || attributes?.url || '';
const imageVariants = Object.values(sizesData)
  .filter(isImageVariant)
  .sort((a, b) => Number(a.width) - Number(b.width));
const attributeSrcSet = typeof attributes?.srcset === 'string' ? attributes.srcset : '';
const propSrcSet = typeof srcset === 'string' ? srcset : '';
const variantSrcSet = imageVariants
  .map((candidate) => `${candidate.source_url || candidate.url || candidate.src} ${candidate.width}w`)
  .join(', ');
const imageSrcSet = attributeSrcSet || propSrcSet || variantSrcSet;
const imageWidth = Number(imageVariant?.width || attributes?.width) || undefined;
const imageHeight = Number(imageVariant?.height || attributes?.height) || undefined;

---
<div class:list={["abcnorio-hero", variant !== 'default' ? variant : undefined, attributes?.className]}>

<div class="abcnorio-hero__image-wrapper">
  {imageSrc && (
    <img
      class="abcnorio-hero__image"
      src={imageSrc}
      srcset={imageSrcSet || undefined}
      sizes="100vw"
      width={imageWidth}
      height={imageHeight}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
</div>
  <div class="abcnorio-hero__content-wrapper">
      <div class="abcnorio-hero__content">
        {RecursiveBlock && innerBlocks.map((block: any) => (
          <RecursiveBlock
            {...recursiveProps}
            component={block.name}
            attributes={block.attributes}
            innerBlocks={block.innerBlocks || null}
          />
        ))}
      </div>
    </div>
</div>

<script>
  import './hero.js';
</script>
