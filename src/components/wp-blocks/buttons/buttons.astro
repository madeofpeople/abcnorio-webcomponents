---
const { innerBlocks = [] } = Astro.props;
---
{innerBlocks.map((block: any) => (
  <a
    class="button"
    href={block.attributes?.url}
    target={block.attributes?.url?.indexOf('http') === 0 ? '_blank' : undefined}
    rel={block.attributes?.url?.indexOf('http') === 0 ? 'noopener noreferrer' : undefined}
  >
    {block.attributes?.text}
  </a>
))}
