---
import { cleanEventBodyArtifactsInHtml } from '../../../util/clean-event-body-artifacts.js';
import { linkifyInstagramMentionsInHtml } from '../../../util/linkify-instagram-mentions.js';

const {
	attributes = {},
	linkMentionsToInstagram = false,
	cleanEventBodyArtifacts = false,
} = Astro.props;
const rawContent = attributes?.content || '';
const cleanedContent = cleanEventBodyArtifacts
	? cleanEventBodyArtifactsInHtml(rawContent)
	: rawContent;
const content = linkMentionsToInstagram
	? linkifyInstagramMentionsInHtml(cleanedContent)
	: cleanedContent;
---
{content && <li class="list-item" set:html={content} />}
