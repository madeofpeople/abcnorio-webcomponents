---
import { ANNOUNCEMENT_TOUT_TAG } from "./announcement-tout.metadata.js";

const {
  class: className,
  toast = "",
  toastHeadingLevel = 2,
  title = "",
  editorShell = false,
} = Astro.props;

const parsedToastHeadingLevel = Number.parseInt(String(toastHeadingLevel), 10);
const normalizedToastHeadingLevel = Number.isFinite(parsedToastHeadingLevel) && parsedToastHeadingLevel >= 1 && parsedToastHeadingLevel <= 6
  ? parsedToastHeadingLevel
  : 2;
const ToastHeading = `h${normalizedToastHeadingLevel}`;

---

<div
  class:list={["announcement-tout", className]}
  data-component={ANNOUNCEMENT_TOUT_TAG}
  data-editor-root={editorShell ? '' : undefined}
>
  {(toast || editorShell) && <ToastHeading class="announcement-tout__toast" data-editor-bind={editorShell ? 'toast' : undefined}>{toast}</ToastHeading>}
  {(title || editorShell) && <h3 class="announcement-tout__title" data-editor-bind={editorShell ? 'title' : undefined}>{title}</h3>}
  <div class="announcement-tout__content">
    <slot />
  </div>
</div>

<style lang="scss" is:global>
  @use "./announcement-tout.scss";
</style>
