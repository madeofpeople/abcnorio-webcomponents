---
import { ANNOUNCEMENT_TOUT_TAG } from "./announcement-tout.metadata.js";

const {
  class: className,
  toast = "",
  toastHeadingLevel = 2,
  title = "",
} = Astro.props;

const parsedToastHeadingLevel = Number.parseInt(String(toastHeadingLevel), 10);
const normalizedToastHeadingLevel = Number.isFinite(parsedToastHeadingLevel) && parsedToastHeadingLevel >= 1 && parsedToastHeadingLevel <= 6
  ? parsedToastHeadingLevel
  : 2;

---

<div
  class:list={["announcement-tout", className]}
  data-component={ANNOUNCEMENT_TOUT_TAG}
>
  {toast && normalizedToastHeadingLevel === 1 && <h1 class="announcement-tout__toast">{toast}</h1>}
  {toast && normalizedToastHeadingLevel === 2 && <h2 class="announcement-tout__toast">{toast}</h2>}
  {toast && normalizedToastHeadingLevel === 3 && <h3 class="announcement-tout__toast">{toast}</h3>}
  {toast && normalizedToastHeadingLevel === 4 && <h4 class="announcement-tout__toast">{toast}</h4>}
  {toast && normalizedToastHeadingLevel === 5 && <h5 class="announcement-tout__toast">{toast}</h5>}
  {toast && normalizedToastHeadingLevel === 6 && <h6 class="announcement-tout__toast">{toast}</h6>}
  {title && <h3 class="announcement-tout__title">{title}</h3>}
  <div class="announcement-tout__content">
    <slot />
  </div>
</div>

<style lang="scss">
  @use "./announcement-tout.scss";
</style>
