---
const {
  class: className,
  href = '#',
  title = 'Untitled event',
  priority = false,
  isPastEvent = false,
  startLabelDate = '',
  startLabelTime = '',
  startDateTime = '',
  featured_image = null,
} = Astro.props;

const imageProps = featured_image && typeof featured_image === 'object' ? featured_image : null;
---

<event-teaser class:list={['event-teaser', 'events', className, { 'event-teaser--past': isPastEvent }]} data-component="abcnorio/event-teaser">
  <a href={href}>
    {imageProps?.url && (
      <img
        class="event-teaser__image"
        src={imageProps.url}
        alt={imageProps.alt || ''}
        width={Number(imageProps.width || 290)}
        height={Number(imageProps.height || 9999)}
        decoding="async"
        fetchpriority={priority ? 'high' : undefined}
        loading={priority ? undefined : 'lazy'}
      />
    )}

    <div class="event-teaser__content">
      {(startLabelDate || startLabelTime) && (
        <time class="event-teaser__date" datetime={startDateTime}>
          <span>{startLabelDate} @ {startLabelTime}</span>
        </time>
      )}

      <h3 class="event-teaser__title" set:html={`${title} ` } />
    </div>
  </a>
</event-teaser>

<script>
  import './event-teaser.js';
</script>

<style lang="scss">
  @use './event-teaser.scss';
</style>