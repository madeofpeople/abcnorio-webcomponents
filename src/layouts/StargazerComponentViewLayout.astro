---
import foundationHref from '../styles/foundation.scss?url';
import previewShellHref from '../styles/stargazer-preview-shell.scss?url';
import stargazerFontsHref from '../styles/stargazer-fonts.scss?url';
import SgPreviewShell from './stargazer/SgPreviewShell.astro';
import SgPreviewShellHeader from './stargazer/SgPreviewShellHeader.astro';
import SgPreviewShellBody from './stargazer/SgPreviewShellBody.astro';

const { title = 'Component Preview' } = Astro.props;
const slug = decodeURIComponent(Astro.url.pathname.split('/').filter(Boolean).pop() || '');

let meta = {
	slug,
	name: title,
	category: '',
	componentPath: '',
};

try {
    const response = await fetch(`${Astro.url.origin}/__stargazer/preview/${encodeURIComponent(slug)}`);
    if (response.ok) {
        const data = await response.json();
        meta = {
            slug: data.slug || slug,
            name: data.name || title,
            category: data.category || '',
            componentPath: data.componentPath || '',
        };
    }
} catch {
}


---

<SgPreviewShell title={title}>
	<link rel="stylesheet" href={previewShellHref} />
	<link rel="stylesheet" href={stargazerFontsHref} />
	<link rel="stylesheet" href={foundationHref} />
    <SgPreviewShellHeader {...meta} />
	<SgPreviewShellBody>
		<slot />
	</SgPreviewShellBody>
</SgPreviewShell>
