---
import { getFixtureStaticPaths } from '../util/component-fixtures.js';

const fixturePaths = getFixtureStaticPaths();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>abcnorio-webcomponents</title>
  </head>
  <body>
    <main>
      <h1>abcnorio-webcomponents</h1>
      <p>Open a fixture route below. This package now serves plain fixture pages.</p>
      <ul>
        {fixturePaths.map(({ params }) => (
          <li>
            <a href={`/${params.slug}`}>{params.slug}</a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
