---
import AddToCalendar from '../../../src/components/add-to-calendar/add-to-calendar.astro';
import EventListing from '../../../src/components/event-listing/event-listing.astro';
import addToCalendarFixtures from '../../../src/components/add-to-calendar/add-to-calendar.fixture.js';
import eventListingFixtures from '../../../src/components/event-listing/event-listing.fixture.js';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>abcnorio webcomponents demo</title>
  <style>
    :root {
      color-scheme: light;
      --page-bg: #f4f0e8;
      --page-ink: #111;
      --page-accent: #bf4327;
      --page-panel: rgba(255, 255, 255, 0.8);
      --color-ui-panel: #e5ddd0;
      --color-text: #111;
      --font-impact-label-reversed: 'Arial Black';
      --font-geist: 'Helvetica Neue';
      font-family: 'IBM Plex Sans', 'Helvetica Neue', sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--page-ink);
      background:
        radial-gradient(circle at top left, rgba(191, 67, 39, 0.18), transparent 28rem),
        linear-gradient(180deg, #f8f4ec 0%, var(--page-bg) 100%);
    }

    main {
      width: min(72rem, calc(100vw - 2rem));
      margin: 0 auto;
      padding: 2rem 0 4rem;
    }

    header {
      margin-bottom: 2rem;
      padding: 1.5rem;
      border: 1px solid rgba(17, 17, 17, 0.12);
      background: var(--page-panel);
      backdrop-filter: blur(0.25rem);
    }

    h1,
    h2,
    p {
      margin-top: 0;
    }

    .demo-grid {
      display: grid;
      gap: 1.5rem;
    }

    .demo-panel {
      padding: 1.5rem;
      border: 1px solid rgba(17, 17, 17, 0.12);
      background: var(--page-panel);
    }

    @media (min-width: 52rem) {
      .demo-grid {
        grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
        align-items: start;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <p>abcnorio-webcomponents</p>
      <h1>Light-DOM Astro component demo</h1>
      <p>Each component owns its Astro markup, local behavior module, and SCSS. No root manifest. Component JS only ships when that component is imported.</p>
    </header>

    <div class="demo-grid">
      <section class="demo-panel" aria-labelledby="calendar-demo-title">
        <h2 id="calendar-demo-title">Add to calendar</h2>
        <AddToCalendar {...addToCalendarFixtures.default.props} />
      </section>

      <section class="demo-panel" aria-labelledby="events-demo-title">
        <h2 id="events-demo-title">Event listing</h2>
        <EventListing {...eventListingFixtures.default.props} />
      </section>
    </div>
  </main>
</body>
</html>