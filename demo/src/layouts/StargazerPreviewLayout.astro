---
const { title = 'Component Preview' } = Astro.props;
---
<section class="sg-preview-shell" aria-label={title}>
  <header class="sg-preview-shell__header">
    <p class="sg-preview-shell__eyebrow">abcnorio-webcomponents</p>
    <h1>{title}</h1>
  </header>
  <div class="sg-preview-shell__body">
    <slot />
  </div>
</section>

<style>
  .sg-preview-shell {
    min-height: 100vh;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top left, rgba(191, 67, 39, 0.18), transparent 28rem),
      linear-gradient(180deg, #f8f4ec 0%, #f4f0e8 100%);
  }

  .sg-preview-shell__header {
    margin-bottom: 1.5rem;
    padding: 1rem;
    border: 1px solid rgba(17, 17, 17, 0.12);
    background: rgba(255, 255, 255, 0.85);
  }

  .sg-preview-shell__eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
  }

  .sg-preview-shell__header h1 {
    margin: 0;
    font-size: 1.25rem;
  }

  .sg-preview-shell__body {
    padding: 1rem;
    border: 1px solid rgba(17, 17, 17, 0.12);
    background: rgba(255, 255, 255, 0.75);
  }
</style>
